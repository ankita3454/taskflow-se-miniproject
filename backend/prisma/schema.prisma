generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER @map("Member")
  OWNER  @map("Owner")
  ADMIN  @map("Admin")
}

model User {
  id           String   @id @default(uuid()) @map("user_id") @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(60)
  role         UserRole @default(MEMBER)
  active       Boolean  @default(true)

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]

  assignedTasks Task[] @relation("TaskAssignee")

  @@map("users")
}

model Project {
  id       String  @id @default(uuid()) @map("project_id") @db.Uuid
  name     String  @db.VarChar(150)
  ownerId  String  @map("owner_id") @db.Uuid
  archived Boolean @default(false)

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks   Task[]

  @@unique([ownerId, name])
  @@map("projects")
}

model ProjectMember {
  projectId   String @map("project_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  projectRole String @default("Member") @map("project_role") @db.VarChar(20)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@map("project_members")
}

enum TaskPriority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")
}

enum TaskStatus {
  TODO        @map("To Do")
  IN_PROGRESS @map("In Progress")
  IN_REVIEW   @map("In Review")
  DONE        @map("Done")
}

model Task {
  id           String       @id @default(uuid()) @map("task_id") @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  title        String       @db.VarChar(200)
  description  String?      @db.VarChar(2000)
  priority     TaskPriority
  dueDate      DateTime?    @map("due_date") @db.Date
  timeEstimate Float?       @map("time_estimate")
  status       TaskStatus   @default(TODO)
  assigneeId   String?      @map("assignee_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}
